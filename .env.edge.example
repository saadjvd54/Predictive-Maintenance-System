# ==============================================================================
# PharmaPredict AI — Industrial Edge Gateway Environment Configuration Template
# ==============================================================================
# Copy to /etc/pharmapredict/edge.env or .env on the industrial edge computer.
# Ensure file permissions are restricted: chmod 600 edge.env (owned by edgeuser).
# DO NOT commit real secrets or production passwords to version control.
# ==============================================================================

# --- Gateway Identity & Multi-Tenancy ---
GATEWAY_ID=gw-edge-packaging-01
ORGANIZATION_ID=00000000-0000-0000-0000-000000000000
EQUIPMENT_ID=0d9bba98-6ad9-417c-9543-ef024447ef04
IS_SIMULATOR=false

# --- Industrial OPC UA Client Connection ---
# Target PLC / SCADA endpoint URL (e.g. Siemens S7-1500, Beckhoff TwinCAT, Rockwell)
OPCUA_ENDPOINT_URL=opc.tcp://192.168.1.100:4840/

# Security Policy: None | Basic256Sha256 | Aes128_Sha256_RsaOaep
OPCUA_SECURITY_POLICY=Basic256Sha256

# Security Mode: None | Sign | SignAndEncrypt
OPCUA_SECURITY_MODE=SignAndEncrypt

# User Authentication Type: Anonymous | UserName | Certificate
OPCUA_AUTH_TYPE=UserName

# Dedicated Read-Only Automation Account (Never use engineer/admin PLC credentials)
OPCUA_USERNAME=pharmapredict_ro
OPCUA_PASSWORD=replace_with_strong_read_only_plc_password

# Client X.509 Certificate and Private Key (generated automatically if left blank)
OPCUA_CERT_PATH=/var/lib/pharmapredict/certs/client_cert.pem
OPCUA_KEY_PATH=/var/lib/pharmapredict/certs/client_key.pem

# Server Certificate Validation Store (Directory containing trusted PLC certificates)
TRUSTED_CERTS_DIR=/var/lib/pharmapredict/trusted_certs
TRUSTED_CERT_FINGERPRINTS=

# Auto-trust unknown certificates (STRICTLY false in production per IEC 62443)
AUTO_TRUST_UNKNOWN=false

# OPC UA Operation Timeout (seconds)
OPCUA_TIMEOUT_SEC=5.0

# --- Cloud Ingestion & Edge-to-Cloud Transport ---
# Production HTTPS ingestion endpoint
CLOUD_INGESTION_URL=https://predictive-maintenance-system-bay.vercel.app/api/v1/internal/ingestion/readings

# Primary Shared Gateway Secret for authentication (X-Gateway-Secret)
GATEWAY_INTERNAL_SECRET=replace_with_strong_random_gateway_secret

# Secondary Secret for zero-downtime secret rotation
GATEWAY_INTERNAL_SECRET_SECONDARY=

# TLS / HTTPS Validation (Strictly true in production)
VERIFY_SSL=true
SSL_CA_BUNDLE=

# Cloud Request Timeout (seconds)
REQUEST_TIMEOUT_SEC=10.0

# Local Test Override (STRICTLY false in production; allows plaintext http:// for unit tests)
ALLOW_INSECURE_HTTP=false

# --- Store-and-Forward Telemetry Buffer ---
BUFFER_DIR=/var/lib/pharmapredict/buffer
MAX_QUEUE_SIZE=5000
MAX_DISK_BUFFER_BYTES=52428800
BATCH_SIZE=50
FLUSH_INTERVAL_SEC=1.0

# --- Health, Logging & Watchdog ---
HEARTBEAT_INTERVAL_SEC=30.0
LOG_LEVEL=INFO
STRUCTURED_LOGS=true
